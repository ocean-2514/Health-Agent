# 电力健康智能体项目全局忽略规则 (Global Git Ignore)

# Python 缓存与编译文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境 (Virtual Environments)
.venv/
venv/
env/
ENV/

# 前端构建与依赖 (Frontend)
node_modules/
dist/
dist-ssr/
*.local

# 系统与 IDE (System/IDE)
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# 日志与临时文件 (Logs/Temp)
*.log
pip-log.txt
*.bak
*.tmp
fusion_output.json

# 压缩包与大数据集 (Large Data/Zip)
*.zip
*.tar.gz
*.7z
*.rar

# 私人/备份目录 (Security)
_legacy_backup/
transformerAgent/
bysj/
stitch/
scripts/

# 第三方运行时与本地测试脚本 (Third-party & Local Tests)
thirdparty/
test_infer.py

Config/GlobalConfig.yaml
/var/*